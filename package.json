{
  "name": "roshan-rozgar",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node server.mjs",
    "dev:local": "node server.mjs",
    "dev:next": "next dev",
    "build": "prisma generate && next build",
    "start": "node server.mjs",
    "start:win": "set NODE_ENV=production&& node server.mjs",
    "setup": "npx prisma db push && npm run db:seed",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@prisma/client": "^6.19.0",
    "@stripe/stripe-js": "^10.2.1",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.511.0",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "stripe": "^23.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.12"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
