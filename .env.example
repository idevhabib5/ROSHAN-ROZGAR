# Copy to .env for local testing with server.mjs
DATABASE_URL="file:./dev.db"

# Optional AI (heuristic parser works without keys)
# Prefer Gemini for extraction + realtime speech-to-speech
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_LIVE_MODEL=gemini-3.8-live
# OPENAI_API_KEY=

# Local dispatch tuning
DISPATCH_RADIUS_STAGES=3,5,10,15
DISPATCH_EXPAND_INTERVAL_SEC=30
DISPATCH_LOCATION_FRESHNESS_SEC=120
DISPATCH_REQUEST_TTL_SEC=900
DISPATCH_OFFER_DEADLINE_SEC=300
DISPATCH_TICKER_MS=5000
DISPATCH_TICK_SECRET=local-dev-tick

# Server bind (0.0.0.0 = reachable from phone on same Wi‑Fi)
HOST=0.0.0.0
PORT=3000

# Leave empty for same-origin Socket.IO (recommended for local server.mjs)
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Auth.js (required secret; Google/Facebook optional)
AUTH_SECRET=replace-with-a-long-random-string
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_FACEBOOK_ID=
# AUTH_FACEBOOK_SECRET=
# AUTH_URL=http://localhost:3000
